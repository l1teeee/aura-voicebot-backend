# Plantilla de variables de entorno de Aura backend.
# Copia este archivo a .env y sustituye los valores de ejemplo por los tuyos.
# Nunca subas el archivo .env al repositorio: contiene secretos reales.

# Puerto HTTP del servidor. Opcional: por defecto 3000.
# En Render y Railway la plataforma inyecta este valor automáticamente.
PORT=3000

# Entorno de ejecución: development | production | test. Opcional: por defecto development.
NODE_ENV=development

# Clave de la API de OpenAI. Se obtiene en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-clave-de-openai

# Modelo de chat usado por Aura. Opcional: por defecto gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Modelo de texto a voz usado por /api/speech. Opcional: por defecto gpt-4o-mini-tts.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voz de OpenAI usada por /api/speech. Opcional: por defecto coral.
# Voces disponibles: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin, cedar.
OPENAI_TTS_VOICE=coral

# Clave de la API de OpenWeatherMap. Se obtiene en https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=tu-clave-de-openweathermap

# URL base de la API de OpenWeatherMap, sin barra final.
# Tiene que incluir el prefijo /data/2.5 y NO terminar en /weather: el código añade
# la ruta del endpoint (/weather y /forecast). Si falta el prefijo, OpenWeatherMap
# responde 404 a todas las ciudades y el bot dice que no encuentra ninguna.
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Webhook donde se registra cada interacción. Crea uno gratis en https://pipedream.com/requestbin
LOG_WEBHOOK_URL=https://tu-endpoint.m.pipedream.net

# Origen del frontend autorizado por CORS. Un único origen, sin barra final.
ALLOWED_ORIGIN=http://localhost:5173

# URL de PostgreSQL para identificación e historial persistente. Opcional para conservar el modo chat anónimo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
